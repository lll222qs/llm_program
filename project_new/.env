# .env

# ==============================
# App Config
# ==============================
LOG_LEVEL=INFO
AGENT_PORT=8000

# ==============================
# LLM Config (Ollama)
# ==============================
# ⚠️ 关键：Docker 容器内访问宿主机必须用 host.docker.internal
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct

# ==============================
# Vector DB Config (Qdrant)
# ==============================
# ⚠️ 关键：容器间通信直接用 docker-compose 里的服务名 "qdrant"
VECTOR_DB_HOST=qdrant
VECTOR_DB_PORT=6333
QDRANT_COLLECTION=langchain

# ==============================
# Redis Config
# ==============================
# ⚠️ 关键：容器间通信直接用服务名 "redis"
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================
# Cache & Models
# ==============================
HF_HOME=/app/model_cache
TRANSFORMERS_CACHE=/app/model_cache